  "schemas": {
    "CreateThreadRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            },
            {
              "maxLength": 191
            }
          ]
        },
        "projectId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "environmentVariables": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/EnvironmentVariableWrite"
          },
          "description": "Write-only environment variables for this thread and its descendants, encrypted at rest. Commands can read the values and outputs are not masked. A replayed requestId preserves the original variables."
        },
        "model": {
          "$ref": "#/components/schemas/ModelSelection",
          "description": "The model to run. A named model that cannot run answers `ModelSelection.Rejected` and never falls back. Absent, the thread starts on the first default the key's principal can run: a human key's own default, else a service user's default, then the organization default, then Capy's default. The create response's `modelDefault` reports which one. When no default can run, the create answers `ModelSelection.Rejected` naming each default and why."
        },
        "machineSize": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large",
            "ultra",
            "hyper",
            "bigguy"
          ]
        },
        "device": {
          "$ref": "#/components/schemas/DeviceTarget"
        },
        "authorId": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "org",
            "private"
          ],
          "description": "Who can see the thread: `org` for everyone at the organization, `private` for its owner and the people it is shared with. Absent, the owner's own default applies, else the organization's. `private` needs a human owner who may create private work, so a service key must name `authorId`."
        },
        "personal": {
          "type": "boolean"
        },
        "pullRequestAuthor": {
          "type": "string",
          "enum": [
            "user",
            "capy"
          ],
          "description": "Who authors this thread's pull requests on GitHub: `capy` for the Capy GitHub App, `user` for the thread's acting human (the `authorId` member, or the key's creator for a service key). Commits and pushes keep the Git identity preference. Absent leaves the preference in charge; a replayed `requestId` keeps the original value."
        },
        "captainId": {
          "type": "string",
          "description": "A Captain in `projectId` to create the thread in, as a crew thread that reports to it. Absent `visibility`, the thread takes the Captain's. A Captain the key cannot see answers `ThreadNotFound`; a join the Captain's access rules refuse answers `CrewRefused` before the first message is admitted, and a retry with the same `requestId` answers the same refusal."
        }
      },
      "required": [
        "requestId",
        "projectId",
        "message"
      ],
      "additionalProperties": false
    },
    "SendMessageRequest": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/MessageFile"
          },
          "description": "Files to attach, such as screenshots or screen recordings, each uploaded first through `POST /files`. The files together must stay within 2 GiB."
        },
        "model": {
          "$ref": "#/components/schemas/ModelSelection"
        },
        "delivery": {
          "type": "string",
          "enum": [
            "queue",
            "steer",
            "interrupt"
          ],
          "description": "How the message reaches a working thread. `interrupt` (the default) cuts the running step and makes the message the next input; `steer` lands it at the agent's next step with nothing cancelled; `queue` waits until the current work finishes."
        },
        "clientKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "A key you choose for this send, unique per message. A retried send with the same key, from the same key's principal to the same thread, posts nothing new and answers the first send's message id with `deduped: true`."
        },
        "editOf": {
          "type": "string",
          "allOf": [
            {
              "minLength": 26
            },
            {
              "maxLength": 26
            }
          ],
          "description": "Resend one of your earlier messages as a new version. The thread resets to that message before the agent reads the new text; the rows after it stay stored and can be switched back to."
        },
        "switchTo": {
          "type": "string",
          "allOf": [
            {
              "minLength": 26
            },
            {
              "maxLength": 26
            }
          ],
          "description": "Make this superseded version of an edited message live before the send lands, so the message answers on that branch."
        },
        "pullRequestAuthor": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user",
                "capy"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Set the thread's pull request author: `capy` or `user` sets it, null clears it back to the Git identity preference, and absent leaves it unchanged. It applies when the agent picks this message up, so a queued message never changes a pull request opened before it."
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "AdmitReceiptEncoded": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "allOf": [
            {
              "minLength": 26
            },
            {
              "maxLength": 26
            }
          ]
        },
        "deduped": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "deduped"
      ],
      "additionalProperties": false
    },
    "ProjectListEncoded": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ProjectEncoded"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "ThreadPageEncoded": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ThreadEncoded"
          }
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{1,15}:.+"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "cursor"
      ],
      "additionalProperties": false
    },
    "TranscriptPageEncoded": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/MessageEncoded"
          }
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 26
                },
                {
                  "maxLength": 26
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque exclusive event-ID cursor for after. Stable across compaction. Null when no newer events remain. An unchanged cursor means unsettled messages still block forward paging. Retry after they settle."
        },
        "beforeCursor": {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 26
                },
                {
                  "maxLength": 26
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Opaque exclusive event-ID cursor for before. Stable across compaction. Null when no older events remain."
        }
      },
      "required": [
        "items",
        "cursor",
        "beforeCursor"
      ],
      "additionalProperties": false
    },
    "MessagePageEncoded": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/MessageEncoded"
          }
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "allOf": [
                {
                  "minLength": 26
                },
                {
                  "maxLength": 26
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "cursor"
      ],
      "additionalProperties": false
    },
    "SubagentPageEncoded": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SubagentEncoded"
          }
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "cursor"
      ],
      "additionalProperties": false
    },
    "SubagentEncoded": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
