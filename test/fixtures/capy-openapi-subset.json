          "type": "string",
          "enum": [
            "user",
            "assistant",
            "tool"
          ]
        },
        "tool": {
          "type": "string"
        },
        "feedbackRequest": {
          "type": "object",
          "properties": {
            "toolCallId": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "proposed",
                "sent",
                "declined"
              ]
            }
          },
          "required": [
            "toolCallId",
            "state"
          ],
          "additionalProperties": false
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string"
              },
              "durationMs": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              }
            },
            "required": [
              "tool",
              "durationMs"
            ],
            "additionalProperties": false
          }
        },
        "text": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "sender": {
          "$ref": "#/components/schemas/MessageSender",
          "description": "On user entries another agent sent: the thread or subagent that sent it. Absent on messages a person, an integration, or an automation sent, and on the opening task a parent gives its subagent."
        },
        "clientKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "editOf": {
          "type": "string",
          "allOf": [
            {
              "minLength": 26
            },
            {
              "maxLength": 26
            }
          ]
        },
        "model": {
          "type": "string"
        },
        "modelDefault": {
          "$ref": "#/components/schemas/DefaultedModel",
          "description": "On user entries whose sender named no model: the model the message selected and the default that supplied it."
        },
        "callId": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "object",
                "properties": {
                  "fileId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "mediaType": {
                    "type": "string"
                  },
                  "sizeBytes": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "Infinity",
                          "-Infinity",
                          "NaN"
                        ]
                      }
                    ]
                  },
                  "preview": {
                    "type": "boolean"
                  },
                  "previewBytes": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "Infinity",
                          "-Infinity",
                          "NaN"
                        ]
                      }
                    ]
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "Infinity",
                          "-Infinity",
                          "NaN"
                        ]
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "Infinity",
                          "-Infinity",
                          "NaN"
                        ]
                      }
                    ]
                  },
                  "pageCount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sourcePath": {
                    "type": "string"
                  },
                  "contentSha": {
                    "type": "string"
                  },
                  "transcript": {
                    "type": "string"
                  }
                },
                "required": [
                  "fileId",
                  "name",
                  "mediaType",
                  "sizeBytes"
                ],
                "additionalProperties": false
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          },
          "description": "On user entries: the files the message carried. On assistant entries: the files the agent delivered with the message, not every file its turn touched."
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "sizeBytes": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  }
                ]
              },
              "fileId": {
                "type": "string"
              }
            },
            "required": [
              "location",
              "path",
              "version"
            ],
            "additionalProperties": false
          },
          "description": "On assistant entries: the Capy Drive files the agent delivered by reference, each with its drive location, path, the drive version at delivery, and the id of its copy in `attachments`."
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "text",
        "createdAt"
      ],
      "additionalProperties": false
    },
