{
  "name": "magpie-capy",
  "version": "0.2.3",
  "description": "Capy 任务平台工具：项目、线程、子代理、消息与有界 SSE。普通产品登录委托未验证；组织 API Key 是可用高级路径，写入默认关闭。",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src/",
    "assets/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "capy",
    "task-agent",
    "api-key"
  ],
  "author": "grokboot contributors",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "check:openapi": "bun test test/contract.test.ts",
    "pack:check": "npm pack --dry-run",
    "pack:release": "bun scripts/pack-release.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "magpie": {
    "name": "Capy",
    "summary": {
      "en": "Capy task-platform tools for projects, threads, subagents, messages, and bounded SSE. Normal product sign-in delegation is unverified; organization API Key is the available advanced path. Writes off by default.",
      "zh": "Capy 任务平台工具：项目、线程、子代理、消息与有界 SSE。普通产品登录委托未验证；组织 API Key 是可用高级路径，写入默认关闭。"
    },
    "icon": "data:image/svg+xml;base64,",
    "options": {
      "allowWrites": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grokboot/magpie-capy.git"
  },
  "homepage": "https://github.com/grokboot/magpie-capy#readme",
  "bugs": {
    "url": "https://github.com/grokboot/magpie-capy/issues"
  }
}
